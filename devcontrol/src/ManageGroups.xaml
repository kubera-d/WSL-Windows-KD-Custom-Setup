<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage groups" Width="1000" Height="620" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#17181C" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Btn / BtnSmall / Icon styles come from the main window: merged in by Show-ManageGroups.
       Column buttons: Uid = action (gleft/gright/grename/gdelete), Tag = group name. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </Window.Resources>
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button x:Name="NewGroupBtn" DockPanel.Dock="Right" Content="New group..." Style="{DynamicResource BtnPrimary}" Margin="0"/>
      <StackPanel>
        <TextBlock Text="Groups" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                   Text="Drag a project onto another group (or between two projects to set its place). Arrows reorder the groups. Deleting a group moves its projects to Ungrouped. Changes are saved immediately."/>
      </StackPanel>
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="Close" IsCancel="True" Style="{DynamicResource Btn}" Margin="0"/>
      <TextBlock x:Name="StatusText" Foreground="#9AA0A6" FontSize="12" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Board" AllowDrop="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="230" Margin="0,0,10,0" Background="#212329" BorderBrush="#33363E" BorderThickness="1" CornerRadius="8">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,6,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding CanEdit, Converter={StaticResource B2V}}">
                    <Button Style="{DynamicResource Icon}" Uid="gleft" Tag="{Binding Name}" Content="&#xE76B;" Width="24" Height="24" FontSize="10" ToolTip="Move group left (up in the list)"/>
                    <Button Style="{DynamicResource Icon}" Uid="gright" Tag="{Binding Name}" Content="&#xE76C;" Width="24" Height="24" FontSize="10" ToolTip="Move group right (down in the list)"/>
                    <Button Style="{DynamicResource Icon}" Uid="grename" Tag="{Binding Name}" Content="&#xE70F;" Width="24" Height="24" FontSize="11" ToolTip="Rename group"/>
                    <Button Style="{DynamicResource Icon}" Uid="gdelete" Tag="{Binding Name}" Content="&#xE74D;" Width="24" Height="24" FontSize="11" ToolTip="Delete group (its projects become Ungrouped)"/>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Hint}" Foreground="#6B7280" FontSize="11"/>
                  </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <!-- the whole column is a drop target, including the empty space below the chips -->
                  <ItemsControl ItemsSource="{Binding Items}" Background="Transparent" MinHeight="300" Margin="8,0,8,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#2C3038" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="0,0,0,5" Cursor="SizeAll"
                                ToolTip="{Binding Name}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
