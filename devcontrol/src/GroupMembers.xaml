<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projects in group" Width="520" Height="640" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#17181C" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Btn / Field styles come from the main window: merged in by Show-GroupMembers.
       Checked = in the group. Unchecking a member makes it Ungrouped; checking a project from
       another group moves it here (a project is in one group at a time). -->
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="HeadText" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                 Text="Tick the projects that belong in this group. A project is in one group at a time: ticking one from another group moves it here."/>
      <Border Background="#1F2126" BorderBrush="#2E3138" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6B7280" Margin="12,0,2,0" VerticalAlignment="Center"/>
          <Grid>
            <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0" Foreground="#E6E6E6" CaretBrush="#E6E6E6" Padding="6,8" FontSize="14"/>
            <TextBlock x:Name="FilterHint" Text="Filter" Foreground="#6B7280" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SaveBtn" Content="Save" IsDefault="True" Style="{DynamicResource BtnPrimary}"/>
        <Button Content="Cancel" IsCancel="True" Style="{DynamicResource Btn}" Margin="0"/>
      </StackPanel>
      <TextBlock x:Name="CountText" Foreground="#9AA0A6" FontSize="12" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Background="#1F2126" BorderBrush="#2E3138" BorderThickness="1" CornerRadius="8">
      <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Foreground="#E6E6E6" Padding="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,6">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262930"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="#E6E6E6" VerticalContentAlignment="Center" Cursor="Hand">
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Sub}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
