<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Control" Width="1100" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#17181C" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#212329"/>
    <SolidColorBrush x:Key="Row" Color="#282B32"/>
    <SolidColorBrush x:Key="Line" Color="#33363E"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#343842"/>
      <Setter Property="BorderBrush" Value="#434854"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#7F1D1D"/><Setter Property="BorderBrush" Value="#B91C1C"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="9,3"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="BtnSmallPrimary" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="B2V"/>
    <Style x:Key="BtnSmallDanger" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="#5B1A1A"/><Setter Property="BorderBrush" Value="#8B2525"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- Borderless glyph button (Segoe MDL2 Assets): card chevron, more, rename -->
    <Style x:Key="Icon" TargetType="Button">
      <Setter Property="Foreground" Value="#9AA0A6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3E48"/><Setter Property="Foreground" Value="#E6E6E6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filter chips (All / Running / Stopped) -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C8CCD2"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#282B32" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="13" Padding="12,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#565B66"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E3A5F"/><Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#17181C"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="BorderBrush" Value="#434854"/>
      <Setter Property="CaretBrush" Value="#E6E6E6"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Editor icons (16x16 vector): Linux penguin and Windows logo -->
    <DrawingImage x:Key="IconLinux">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1B1B1B" Geometry="M8,0.6 C5.1,0.6 4.3,3 4.3,5.1 C4.3,6.9 3.1,8.1 2.5,9.9 C1.9,11.8 2.3,13.9 3.6,15 L12.4,15 C13.7,13.9 14.1,11.8 13.5,9.9 C12.9,8.1 11.7,6.9 11.7,5.1 C11.7,3 10.9,0.6 8,0.6 Z">
            <GeometryDrawing.Pen><Pen Brush="#C8C8C8" Thickness="0.7"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#F4F4F4" Geometry="M8,6.3 C6.3,6.3 5.3,8.5 5.3,10.8 C5.3,13 6.4,14.3 8,14.3 C9.6,14.3 10.7,13 10.7,10.8 C10.7,8.5 9.7,6.3 8,6.3 Z"/>
          <GeometryDrawing Brush="#F4F4F4" Geometry="M6.1,3.6 a0.85,1.05 0 1,0 1.7,0 a0.85,1.05 0 1,0 -1.7,0 Z M8.2,3.6 a0.85,1.05 0 1,0 1.7,0 a0.85,1.05 0 1,0 -1.7,0 Z"/>
          <GeometryDrawing Brush="#111111" Geometry="M6.75,3.8 a0.35,0.45 0 1,0 0.7,0 a0.35,0.45 0 1,0 -0.7,0 Z M8.55,3.8 a0.35,0.45 0 1,0 0.7,0 a0.35,0.45 0 1,0 -0.7,0 Z"/>
          <GeometryDrawing Brush="#F2A900" Geometry="M6.5,5.1 L9.5,5.1 L8,6.6 Z M2.4,15.6 C2.4,14.3 4.2,13.7 5.7,14.6 L6.5,15.6 Z M13.6,15.6 C13.6,14.3 11.8,13.7 10.3,14.6 L9.5,15.6 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconWindows">
      <DrawingImage.Drawing>
        <GeometryDrawing Brush="#3FA9F5" Geometry="M0.5,0.5 H7.5 V7.5 H0.5 Z M8.5,0.5 H15.5 V7.5 H8.5 Z M0.5,8.5 H7.5 V15.5 H0.5 Z M8.5,8.5 H15.5 V15.5 H8.5 Z"/>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="AppIcon" Width="30" Height="30" Margin="0,0,10,0"/>
        <TextBlock Text="Dev Control" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Pill}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="WslDot" Width="9" Height="9" Fill="#6B7280" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="WslText" Text="WSL: ..." FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Pill}" ToolTip="Working set of the VmmemWSL process">
          <TextBlock x:Name="MemText" Text="Memory: -"/>
        </Border>
        <Border x:Name="ModePill" Style="{StaticResource Pill}" ToolTip="Mode in %USERPROFILE%\.wslconfig (applies at next WSL start)">
          <TextBlock x:Name="ModeText" Text="Mode: -"/>
        </Border>
        <Border Style="{StaticResource Pill}" ToolTip="What the running VM actually has">
          <TextBlock x:Name="LiveText" Text="Live: -" Foreground="{StaticResource Muted}"/>
        </Border>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left column -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="WSL"/>
              <TextBlock Style="{StaticResource Hint}" Text="Mode" Margin="0,0,0,4"/>
              <ComboBox x:Name="ModeCombo" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="StartBtn" Style="{StaticResource BtnPrimary}" Content="Start WSL"
                        ToolTip="Boot WSL. With a mode picked, that mode file is copied to .wslconfig first; with no mode, WSL starts on the current .wslconfig."/>
                <Button x:Name="StopWslBtn" Style="{StaticResource BtnDanger}" Content="Stop WSL"
                        ToolTip="Runs wsl --shutdown: frees the VM's memory and CPU, stops all containers and tools"/>
              </StackPanel>
              <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,10,0,0"
                         Text="Start copies the mode file to .wslconfig, then boots WSL (no mode = start as configured). Stop WSL runs wsl --shutdown."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="VS Code"/>
              <TextBlock x:Name="CodeText" Style="{StaticResource Hint}" Text="VS Code: -" Margin="0,0,0,10"/>
              <TextBlock Style="{StaticResource Hint}" Text="Open a new window (no folder):" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button x:Name="CodeOpenBtn" Style="{StaticResource Btn}" Margin="0,0,6,6"
                        ToolTip="New Linux VS Code window (runs in WSL through WSLg); starts WSL first if it is stopped">
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconLinux}" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Linux VS Code" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="CodeOpenWinBtn" Style="{StaticResource Btn}" Margin="0,0,6,6"
                        ToolTip="New Windows VS Code window (local Windows app; does not need WSL)">
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconWindows}" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Windows VS Code" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="CodeQuitBtn" Style="{StaticResource BtnDanger}" Content="Quit Linux VS Code" Margin="0,0,6,6"
                        ToolTip="Closes every Linux VS Code window in WSL (terminals and sessions inside them stop). WSL, containers and Windows VS Code keep running."/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Pinned"/>
              <ItemsControl x:Name="PinnedList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Row}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource BtnPrimary}" Uid="run" Tag="{Binding Name}" Content="Run" IsEnabled="{Binding CanRun}" Padding="14,6"/>
                          <Button Style="{StaticResource Btn}" Uid="stop" Tag="{Binding Name}" Content="Stop" IsEnabled="{Binding CanAct}" Margin="0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ShortStatus}" Foreground="#9AA0A6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="PinnedHint" Style="{StaticResource Hint}" Text=""/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right column: projects. Collapsed card = title + primary action + status; the chevron opens details. -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="StopAllBtn" Style="{StaticResource BtnSmallDanger}" Content="Stop all containers"
                      ToolTip="docker stop every running container in WSL"/>
              <Button x:Name="ManageGroupsBtn" Style="{StaticResource BtnSmall}" Content="Manage groups"
                      ToolTip="Create, rename, reorder and delete groups; drag projects between them"/>
              <Button x:Name="RefreshBtn" Style="{StaticResource BtnSmall}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Padding="8,4"
                      ToolTip="Look for new project folders and refresh container status now"/>
              <Button x:Name="ProjectsMenuBtn" Style="{StaticResource BtnSmall}" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Padding="8,4" Margin="0"
                      ToolTip="projects.json: edit in Notepad, reload"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Projects" Margin="0"/>
              <TextBlock x:Name="ProjectsHint" Style="{StaticResource Hint}" Text=""/>
            </StackPanel>
          </DockPanel>

          <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="GroupFilter" Width="170" Margin="0,0,10,0" ToolTip="Show one group only"/>
              <CheckBox x:Name="ShowHiddenBox" Content="Show hidden" Foreground="#9AA0A6" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="StatusFilter" Content="All" IsChecked="True"/>
              <RadioButton x:Name="FilterRunning" Style="{StaticResource Chip}" GroupName="StatusFilter" Content="Running"
                           ToolTip="Projects with running containers or background tools"/>
              <RadioButton x:Name="FilterStopped" Style="{StaticResource Chip}" GroupName="StatusFilter" Content="Stopped"/>
              <Grid Width="190" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}"/>
                <TextBlock x:Name="SearchHint" Text="Search projects" Foreground="#6B7280" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </StackPanel>
          </DockPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProjectList">
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <Expander IsExpanded="{Binding Items[0].GroupExpanded, Mode=OneTime}" Tag="{Binding Name}" Margin="0,0,0,8" Foreground="#E6E6E6"
                                      ToolTip="Right-click to rename, reorder or delete this group">
                              <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#C8CCD2"/>
                                  <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="#6B7280"/>
                                </StackPanel>
                              </Expander.Header>
                              <ItemsPresenter Margin="0,6,0,0"/>
                            </Expander>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </ItemsControl.GroupStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Margin="0,0,0,6" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Row}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHiddenRow}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                          <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="BorderBrush" Value="#3A3E48"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <!-- header: a click anywhere here (outside buttons) opens / closes the details -->
                      <DockPanel Uid="hdr" Background="Transparent" Cursor="Hand" Margin="12,6,6,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Uid="{Binding PrimaryUid}" Tag="{Binding Name}" Content="{Binding PrimaryText}" IsEnabled="{Binding PrimaryEnabled}"
                                  ToolTip="{Binding PrimaryTip}" Visibility="{Binding ShowPrimary, Converter={StaticResource B2V}}" MinWidth="58">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding PrimaryUid}" Value="run">
                                    <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Style="{StaticResource BtnSmall}" Uid="codedef" Tag="{Binding Name}" Content="VS Code" IsEnabled="{Binding CanCode}"
                                  Visibility="{Binding IsProject, Converter={StaticResource B2V}}" ToolTip="{Binding CodeTip}"/>
                          <Button Style="{StaticResource Icon}" Uid="menu" Tag="{Binding Name}" Content="&#xE712;" Margin="2,0,0,0"
                                  Visibility="{Binding IsProject, Converter={StaticResource B2V}}" ToolTip="Edit details, group, pin, hide"/>
                          <Border Background="#1F2127" CornerRadius="11" Padding="9,3" Margin="6,0,2,0" VerticalAlignment="Center" MinWidth="86" ToolTip="{Binding Status}">
                            <StackPanel Orientation="Horizontal">
                              <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#C8CCD2" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Border>
                          <Button Uid="toggle" Tag="{Binding Name}" ToolTip="Show / hide details">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource Icon}">
                                <Setter Property="Content" Value="&#xE70D;"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Content" Value="&#xE70E;"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#93C5FD" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsPinned, Converter={StaticResource B2V}}" ToolTip="Pinned"/>
                          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Folder}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBox Uid="titlebox" Tag="{Binding Name}" Text="{Binding Title, Mode=OneWay}" MinWidth="240" FontSize="14"
                                   Style="{StaticResource Field}" Visibility="{Binding IsEditing, Converter={StaticResource B2V}}"/>
                          <Button Style="{StaticResource Icon}" Uid="rename" Tag="{Binding Name}" Content="&#xE70F;" Width="24" Height="24" FontSize="11" Margin="4,0,0,0"
                                  Visibility="{Binding IsProject, Converter={StaticResource B2V}}"
                                  ToolTip="Rename (changes the name shown here; the folder keeps its name)"/>
                          <Border Background="#14532D" CornerRadius="3" Padding="6,0" Margin="6,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsNew, Converter={StaticResource B2V}}" ToolTip="New folder since you last looked - open it to clear">
                            <TextBlock Text="New" FontSize="11" Foreground="#86EFAC"/>
                          </Border>
                          <Border Background="#1E3A5F" CornerRadius="3" Padding="6,0" Margin="6,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasMode, Converter={StaticResource B2V}}" ToolTip="WSL mode this project runs in">
                            <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="#93C5FD"/>
                          </Border>
                          <Border Background="#2E2A45" CornerRadius="3" Padding="6,0" Margin="6,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasWorktrees, Converter={StaticResource B2V}}" ToolTip="Git worktrees of this project (see details)">
                            <TextBlock Text="{Binding WorktreeBadge}" FontSize="11" Foreground="#C4B5FD"/>
                          </Border>
                        </StackPanel>
                      </DockPanel>

                      <!-- details -->
                      <Border BorderBrush="#33363E" BorderThickness="0,1,0,0" Padding="14,10,12,12"
                              Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                        <StackPanel>
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,6"
                                     Visibility="{Binding HasDescription, Converter={StaticResource B2V}}"/>
                          <TextBlock Text="{Binding Facts}" Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Info}" Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                     Visibility="{Binding HasInfo, Converter={StaticResource B2V}}"/>
                          <TextBlock Text="{Binding Warning}" Foreground="#F59E0B" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                     Visibility="{Binding HasWarning, Converter={StaticResource B2V}}"/>
                          <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsProject, Converter={StaticResource B2V}}">
                            <Button Style="{StaticResource BtnSmall}" Uid="restart" Tag="{Binding Name}" Content="Restart" IsEnabled="{Binding CanAct}" Margin="0,0,6,6"
                                    Visibility="{Binding ShowRun, Converter={StaticResource B2V}}" ToolTip="compose restart, restart background tools"/>
                            <Button Style="{StaticResource BtnSmall}" Uid="open" Tag="{Binding Name}" ToolTip="{Binding Url}" Margin="0,0,6,6"
                                    Visibility="{Binding HasUrl, Converter={StaticResource B2V}}">
                              <TextBlock Text="{Binding Url, StringFormat='Open {0}'}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Uid="code" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Margin="0,0,6,6"
                                    ToolTip="Open in Linux VS Code (WSLg); starts WSL first if it is stopped">
                              <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconLinux}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Linux VS Code"/>
                              </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Uid="codewin" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Margin="0,0,6,6"
                                    ToolTip="Open in Windows VS Code (Remote - WSL); starts WSL first if it is stopped">
                              <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconWindows}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Windows VS Code"/>
                              </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Uid="edit" Tag="{Binding Name}" Content="Edit details..." Margin="0,0,6,6"
                                    ToolTip="Name, description, group, mode, URL, compose, tools"/>
                          </WrapPanel>

                          <ItemsControl ItemsSource="{Binding Children}" Margin="0,4,0,0" Visibility="{Binding HasChildren, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="#33363E" BorderThickness="0,1,0,0" Padding="0,5,0,4">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="130"/><ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                      <TextBlock Text="{Binding Detail}" Foreground="#9AA0A6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" ToolTip="CPU"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Mem}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" ToolTip="Memory"/>
                                    <Button Grid.Column="4" Style="{StaticResource BtnSmallDanger}" Uid="child" Tag="{Binding Tag}" Content="Stop" Margin="0"
                                            HorizontalAlignment="Right" IsEnabled="{Binding CanAct}" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <StackPanel Margin="0,8,0,0" Visibility="{Binding HasWorktrees, Converter={StaticResource B2V}}">
                            <TextBlock Text="Git worktrees (extra checkouts of this repo on other branches, as sibling folders)" Foreground="#C4B5FD" FontSize="12" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Worktrees}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border BorderBrush="#33363E" BorderThickness="0,1,0,0" Padding="0,5,0,4">
                                    <DockPanel>
                                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnSmall}" Uid="code" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Padding="7,3"
                                                ToolTip="Open this worktree in Linux VS Code">
                                          <Image Source="{StaticResource IconLinux}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnSmall}" Uid="codewin" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Padding="7,3" Margin="0"
                                                ToolTip="Open this worktree in Windows VS Code">
                                          <Image Source="{StaticResource IconWindows}" Width="14" Height="14"/>
                                        </Button>
                                      </StackPanel>
                                      <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding StatusColor}" Margin="4,0,9,0" VerticalAlignment="Center"/>
                                      <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock Text="{Binding Info}" Foreground="#9AA0A6" FontSize="11" TextWrapping="Wrap"/>
                                      </StackPanel>
                                    </DockPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Activity log -->
    <Border Grid.Row="2" Margin="0,12,0,0" Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
      <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C8CCD2" BorderThickness="0"
               FontFamily="Consolas" FontSize="12" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Border>
  </Grid>
</Window>
