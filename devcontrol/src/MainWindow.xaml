<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Control" Width="1060" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#17181C" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1F2126"/>
    <SolidColorBrush x:Key="Row" Color="#202227"/>
    <SolidColorBrush x:Key="RowHover" Color="#262930"/>
    <SolidColorBrush x:Key="Line" Color="#2E3138"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="Faint" Color="#6B7280"/>
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#2A2D35"/>
      <Setter Property="BorderBrush" Value="#3A3E48"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#7F1D1D"/><Setter Property="BorderBrush" Value="#B91C1C"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="9,3"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="BtnSmallPrimary" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BtnSmallDanger" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="#4A1919"/><Setter Property="BorderBrush" Value="#7F2323"/>
    </Style>
    <!-- Quiet button: no fill until hovered (header actions, row VS Code button) -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#30343D"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Dark drop-down for the header (the system ComboBox ignores Background) -->
    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="10,5">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#30343D"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#1E3A5F"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="#2A2D35" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="6">
                      <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#9AA0A6"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,9,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#30343D"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="#24272E" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Borderless glyph button (Segoe MDL2 Assets): more, chevron, clear -->
    <Style x:Key="Icon" TargetType="Button">
      <Setter Property="Foreground" Value="#9AA0A6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#30343D"/><Setter Property="Foreground" Value="#E6E6E6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- View tabs (All / Running / groups / Ungrouped / Hidden), created in code -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B4B9C0"/>
      <Setter Property="Margin" Value="0,0,4,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AllowDrop" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#24272E"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A2E37"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#17181C"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="BorderBrush" Value="#434854"/>
      <Setter Property="CaretBrush" Value="#E6E6E6"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Editor icons (16x16 vector): Linux penguin and Windows logo -->
    <DrawingImage x:Key="IconLinux">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1B1B1B" Geometry="M8,0.6 C5.1,0.6 4.3,3 4.3,5.1 C4.3,6.9 3.1,8.1 2.5,9.9 C1.9,11.8 2.3,13.9 3.6,15 L12.4,15 C13.7,13.9 14.1,11.8 13.5,9.9 C12.9,8.1 11.7,6.9 11.7,5.1 C11.7,3 10.9,0.6 8,0.6 Z">
            <GeometryDrawing.Pen><Pen Brush="#C8C8C8" Thickness="0.7"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#F4F4F4" Geometry="M8,6.3 C6.3,6.3 5.3,8.5 5.3,10.8 C5.3,13 6.4,14.3 8,14.3 C9.6,14.3 10.7,13 10.7,10.8 C10.7,8.5 9.7,6.3 8,6.3 Z"/>
          <GeometryDrawing Brush="#F4F4F4" Geometry="M6.1,3.6 a0.85,1.05 0 1,0 1.7,0 a0.85,1.05 0 1,0 -1.7,0 Z M8.2,3.6 a0.85,1.05 0 1,0 1.7,0 a0.85,1.05 0 1,0 -1.7,0 Z"/>
          <GeometryDrawing Brush="#111111" Geometry="M6.75,3.8 a0.35,0.45 0 1,0 0.7,0 a0.35,0.45 0 1,0 -0.7,0 Z M8.55,3.8 a0.35,0.45 0 1,0 0.7,0 a0.35,0.45 0 1,0 -0.7,0 Z"/>
          <GeometryDrawing Brush="#F2A900" Geometry="M6.5,5.1 L9.5,5.1 L8,6.6 Z M2.4,15.6 C2.4,14.3 4.2,13.7 5.7,14.6 L6.5,15.6 Z M13.6,15.6 C13.6,14.3 11.8,13.7 10.3,14.6 L9.5,15.6 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconWindows">
      <DrawingImage.Drawing>
        <GeometryDrawing Brush="#3FA9F5" Geometry="M0.5,0.5 H7.5 V7.5 H0.5 Z M8.5,0.5 H15.5 V7.5 H8.5 Z M0.5,8.5 H7.5 V15.5 H0.5 Z M8.5,8.5 H15.5 V15.5 H8.5 Z"/>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Resources>

  <Grid Margin="20,14,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header: status, WSL, VS Code -->
      <RowDefinition Height="Auto"/>  <!-- search -->
      <RowDefinition Height="Auto"/>  <!-- view tabs -->
      <RowDefinition Height="*"/>     <!-- projects -->
      <RowDefinition Height="Auto"/>  <!-- activity log -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <!-- Title shrinks (ellipsis) before the controls on the right do -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
        <Image x:Name="AppIcon" Width="24" Height="24" Margin="0,0,10,0"/>
        <TextBlock Text="Dev Control" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- WSL: one status pill, then only the buttons that make sense right now -->
        <Border x:Name="ModePill" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="12,5" Margin="0,0,8,0">
          <Border.ToolTip>
            <StackPanel>
              <TextBlock x:Name="LiveText" Text="" FontWeight="SemiBold"/>
              <TextBlock Text="Memory = working set of the VmmemWSL process."/>
            </StackPanel>
          </Border.ToolTip>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="WslDot" Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="WslText" Text="WSL ..." FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="MemText" Text="" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ModeText" Text="" Margin="10,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ComboBox x:Name="ModeCombo" Style="{StaticResource DarkCombo}" Width="112" Margin="0,0,6,0" VerticalAlignment="Center"
                  ToolTip="WSL mode: the .wslconfig that Start / Restart copies into place"/>
        <Button x:Name="StartBtn" Style="{StaticResource BtnSmallPrimary}" Content="Start WSL" Padding="11,4"
                ToolTip="Boot WSL. With a mode picked, that mode file is copied to .wslconfig first; with no mode, WSL starts on the current .wslconfig."/>
        <Button x:Name="StopWslBtn" Style="{StaticResource BtnSmallDanger}" Content="Stop WSL" Padding="11,4"
                ToolTip="Runs wsl --shutdown: frees the VM's memory and CPU, stops all containers and tools"/>

        <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="8,0,10,0" VerticalAlignment="Center"/>

        <Button x:Name="CodeOpenBtn" Style="{StaticResource BtnGhost}" Padding="7,5" Margin="0,0,2,0"
                ToolTip="New Linux VS Code window (runs in WSL through WSLg); starts WSL first if it is stopped">
          <Image Source="{StaticResource IconLinux}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="CodeOpenWinBtn" Style="{StaticResource BtnGhost}" Padding="7,5" Margin="0,0,2,0"
                ToolTip="New Windows VS Code window (local Windows app; does not need WSL)">
          <Image Source="{StaticResource IconWindows}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="CodeQuitBtn" Style="{StaticResource BtnGhost}" Padding="8,5" Margin="0,0,2,0"
                ToolTip="Quit Linux VS Code: closes every Linux VS Code window in WSL (terminals and sessions inside them stop). WSL, containers and Windows VS Code keep running.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F87171" VerticalAlignment="Center"/>
            <TextBlock x:Name="CodeText" Text="" FontSize="12" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="MoreBtn" Style="{StaticResource Icon}" Content="&#xE712;" Margin="4,0,0,0"
                ToolTip="Refresh, stop all containers, projects.json, activity log"/>
      </StackPanel>
    </Grid>

    <!-- Search -->
    <Border x:Name="SearchFrame" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Faint}" Margin="16,0,4,0" VerticalAlignment="Center"/>
        <Button x:Name="SearchClearBtn" DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE711;" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Clear (Esc)"/>
        <TextBlock x:Name="SearchKeys" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"
                   Text="Ctrl+F" ToolTip="Up / Down pick a project. Enter opens it in VS Code, Ctrl+Enter runs or stops it, Esc clears."/>
        <Grid>
          <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#E6E6E6" CaretBrush="#E6E6E6"
                   FontSize="15" Padding="6,11" VerticalContentAlignment="Center"/>
          <TextBlock x:Name="SearchHint" Text="Search projects by name, folder, group or description" FontSize="15"
                     Foreground="{StaticResource Faint}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </DockPanel>
    </Border>

    <!-- View tabs. Drop a project on a group tab to move it there. -->
    <DockPanel Grid.Row="2" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
        <StackPanel x:Name="GroupTools" Orientation="Horizontal" Visibility="Collapsed">
          <Button x:Name="AddToGroupBtn" Style="{StaticResource BtnSmall}" Margin="0,0,4,0" ToolTip="Pick which projects belong to this group">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Add projects"/>
            </StackPanel>
          </Button>
          <Button x:Name="GroupMenuBtn" Style="{StaticResource Icon}" Content="&#xE712;" Margin="0,0,6,0" ToolTip="Rename, move or delete this group"/>
        </StackPanel>
        <Button x:Name="SortBtn" Style="{StaticResource BtnGhost}" ToolTip="Sort order (pinned projects always come first)" Margin="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SortText" Text="Recent" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <WrapPanel x:Name="ViewTabs"/>
    </DockPanel>

    <!-- Projects -->
    <Grid Grid.Row="3">
      <ScrollViewer x:Name="ProjectScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="ProjectsHint" Style="{StaticResource Hint}" Text="" Margin="4,2,0,8" Visibility="Collapsed"/>
          <ItemsControl x:Name="ProjectList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Margin="0,0,0,4" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource Row}"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RowHover}"/></Trigger>
                        <DataTrigger Binding="{Binding IsHiddenRow}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="BorderBrush" Value="#363A44"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="#3B82F6"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <!-- header: a click anywhere here (outside buttons) opens / closes the details; drag it onto a tab -->
                    <DockPanel Uid="hdr" Background="Transparent" Cursor="Hand" Margin="14,8,8,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Uid="{Binding PrimaryUid}" Tag="{Binding Name}" Content="{Binding PrimaryText}" IsEnabled="{Binding PrimaryEnabled}"
                                ToolTip="{Binding PrimaryTip}" Visibility="{Binding ShowPrimary, Converter={StaticResource B2V}}" MinWidth="60">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding PrimaryUid}" Value="run">
                                  <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Uid="codedef" Tag="{Binding Name}" Content="Code" IsEnabled="{Binding CanCode}" Padding="8,3"
                                Visibility="{Binding IsProject, Converter={StaticResource B2V}}" ToolTip="{Binding CodeTip}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                              <Setter Property="ContentTemplate">
                                <Setter.Value>
                                  <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                      <Image Source="{StaticResource IconLinux}" Width="14" Height="14" Margin="0,0,6,0"/>
                                      <TextBlock Text="Code"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CodeIsWindows}" Value="True">
                                  <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                      <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                          <Image Source="{StaticResource IconWindows}" Width="14" Height="14" Margin="0,0,6,0"/>
                                          <TextBlock Text="Code"/>
                                        </StackPanel>
                                      </DataTemplate>
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Style="{StaticResource Icon}" Uid="menu" Tag="{Binding Name}" Content="&#xE712;"
                                Visibility="{Binding IsProject, Converter={StaticResource B2V}}" ToolTip="Edit, group, pin, hide, open in..."/>
                        <Button Uid="toggle" Tag="{Binding Name}" ToolTip="Show / hide details">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Icon}">
                              <Setter Property="Content" Value="&#xE70D;"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Content" Value="&#xE70E;"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>

                      <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,7,12,0" VerticalAlignment="Top" ToolTip="{Binding Status}"/>
                      <StackPanel VerticalAlignment="Center">
                        <!-- line 1: title and tags -->
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" MaxWidth="420">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBox Uid="titlebox" Tag="{Binding Name}" Text="{Binding Title, Mode=OneWay}" MinWidth="240" FontSize="14"
                                   Style="{StaticResource Field}" Visibility="{Binding IsEditing, Converter={StaticResource B2V}}"/>
                          <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#93C5FD" Margin="7,1,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsPinned, Converter={StaticResource B2V}}" ToolTip="Pinned: kept at the top and in the tray menu"/>
                          <Border Background="#14532D" CornerRadius="3" Padding="6,0" Margin="7,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsNew, Converter={StaticResource B2V}}" ToolTip="New folder since you last looked - open it to clear">
                            <TextBlock Text="New" FontSize="11" Foreground="#86EFAC"/>
                          </Border>
                          <Border Background="#1E3A5F" CornerRadius="3" Padding="6,0" Margin="7,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasMode, Converter={StaticResource B2V}}" ToolTip="WSL mode this project runs in">
                            <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="#93C5FD"/>
                          </Border>
                          <Border Background="#2E2A45" CornerRadius="3" Padding="6,0" Margin="7,1,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasWorktrees, Converter={StaticResource B2V}}" ToolTip="Git worktrees of this project (see details)">
                            <TextBlock Text="{Binding WorktreeBadge}" FontSize="11" Foreground="#C4B5FD"/>
                          </Border>
                        </StackPanel>
                        <!-- line 2: group (click to change), status, recency -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                          <Button Uid="group" Tag="{Binding Name}" Cursor="Hand" Visibility="{Binding IsProject, Converter={StaticResource B2V}}"
                                  ToolTip="Change group" Margin="-4,0,6,0">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="4,0">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{TemplateBinding Foreground}" Margin="0,1,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="t" Text="{Binding GroupLabel}" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#30343D"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#B4B9C0"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasGroup}" Value="False"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>

                    <!-- details -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="34,10,12,12"
                            Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}">
                      <StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding HasDescription, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding Facts}" Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Info}" Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasInfo, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding Warning}" Foreground="#F59E0B" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasWarning, Converter={StaticResource B2V}}"/>
                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsProject, Converter={StaticResource B2V}}">
                          <Button Style="{StaticResource BtnSmall}" Uid="restart" Tag="{Binding Name}" Content="Restart" IsEnabled="{Binding CanAct}" Margin="0,0,6,6"
                                  Visibility="{Binding ShowRun, Converter={StaticResource B2V}}" ToolTip="compose restart, restart background tools"/>
                          <Button Style="{StaticResource BtnSmall}" Uid="open" Tag="{Binding Name}" ToolTip="{Binding Url}" Margin="0,0,6,6"
                                  Visibility="{Binding HasUrl, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Url, StringFormat='Open {0}'}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                          </Button>
                          <Button Style="{StaticResource BtnSmall}" Uid="code" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Margin="0,0,6,6"
                                  ToolTip="Open in Linux VS Code (WSLg); starts WSL first if it is stopped">
                            <StackPanel Orientation="Horizontal">
                              <Image Source="{StaticResource IconLinux}" Width="14" Height="14" Margin="0,0,6,0"/>
                              <TextBlock Text="Linux VS Code"/>
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource BtnSmall}" Uid="codewin" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Margin="0,0,6,6"
                                  ToolTip="Open in Windows VS Code (Remote - WSL); starts WSL first if it is stopped">
                            <StackPanel Orientation="Horizontal">
                              <Image Source="{StaticResource IconWindows}" Width="14" Height="14" Margin="0,0,6,0"/>
                              <TextBlock Text="Windows VS Code"/>
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource BtnSmall}" Uid="edit" Tag="{Binding Name}" Content="Edit details..." Margin="0,0,6,6"
                                  ToolTip="Name, description, group, mode, URL, compose, tools"/>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding Children}" Margin="0,4,0,0" Visibility="{Binding HasChildren, Converter={StaticResource B2V}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,5,0,4">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="180"/><ColumnDefinition Width="56"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#9AA0A6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" ToolTip="CPU"/>
                                  <TextBlock Grid.Column="3" Text="{Binding Mem}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" ToolTip="Memory"/>
                                  <Button Grid.Column="4" Style="{StaticResource BtnSmallDanger}" Uid="child" Tag="{Binding Tag}" Content="Stop" Margin="0"
                                          HorizontalAlignment="Right" IsEnabled="{Binding CanAct}" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasWorktrees, Converter={StaticResource B2V}}">
                          <TextBlock Text="Git worktrees (extra checkouts of this repo on other branches, as sibling folders)" Foreground="#C4B5FD" FontSize="12" Margin="0,0,0,4"/>
                          <ItemsControl ItemsSource="{Binding Worktrees}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,5,0,4">
                                  <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                      <Button Style="{StaticResource BtnSmall}" Uid="code" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Padding="7,3"
                                              ToolTip="Open this worktree in Linux VS Code">
                                        <Image Source="{StaticResource IconLinux}" Width="14" Height="14"/>
                                      </Button>
                                      <Button Style="{StaticResource BtnSmall}" Uid="codewin" Tag="{Binding Name}" IsEnabled="{Binding CanCode}" Padding="7,3" Margin="0"
                                              ToolTip="Open this worktree in Windows VS Code">
                                        <Image Source="{StaticResource IconWindows}" Width="14" Height="14"/>
                                      </Button>
                                    </StackPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding StatusColor}" Margin="4,0,9,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name}" FontSize="12"/>
                                      <TextBlock Text="{Binding Info}" Foreground="#9AA0A6" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- empty state (no project in this view) -->
          <StackPanel x:Name="EmptyState" Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
            <Button x:Name="EmptyAddBtn" Style="{StaticResource BtnSmallPrimary}" Content="Add projects to this group" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Activity log: one line; click to open the full log -->
    <StackPanel Grid.Row="4" Margin="0,10,0,0">
      <Border x:Name="LogPanel" Height="160" Margin="0,0,0,6" Background="#111215" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C8CCD2" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </Border>
      <DockPanel x:Name="LogBar" Background="Transparent" Cursor="Hand" ToolTip="Show / hide the activity log">
        <TextBlock x:Name="LogToggleText" DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <TextBlock x:Name="LastLogText" Text="" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
