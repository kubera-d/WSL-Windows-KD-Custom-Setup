# Linux scripts must keep LF endings even when cloned on Windows with core.autocrlf=true,
# or sh fails with "$'\r': command not found".
* text=auto
*.sh text eol=lf
linux/** text eol=lf
*.ps1 text eol=crlf
*.xaml text eol=crlf
*.cs text eol=crlf
*.wslconfig text eol=crlf
*.png binary
*.ico binary
*.exe binary
tools/hooks/* text eol=lf
